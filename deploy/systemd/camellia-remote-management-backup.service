[Unit]
Description=Back up Camellia Remote Management PostgreSQL
Requires=camellia-remote-management-stack.service
After=camellia-remote-management-stack.service

[Service]
Type=oneshot
EnvironmentFile=/etc/camellia-remote-management/management.env
ExecStart=/opt/camellia-remote-management/backup-postgres.sh
User=root
Group=root
UMask=0077
ExecStartPre=/usr/bin/test -x /usr/bin/age
ExecStartPre=/usr/bin/test -f /opt/camellia-remote-management/scripts/backup_envelope.py
ExecStartPre=/usr/bin/test ! -L /opt/camellia-remote-management/scripts/backup_envelope.py
ExecStartPre=/usr/bin/test -x /opt/camellia-remote-management/backup-postgres.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/camellia-remote-management
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
SystemCallArchitectures=native
