[Unit]
Description=Back up Camellia Remote Management database and recording inventory
After=camellia-remote-management-stack.service
OnFailure=camellia-remote-management-maintenance-failure@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/camellia-remote-management/management.env
ExecStart=/opt/camellia-remote-management/deploy/run-maintenance-backup.sh
TimeoutStartSec=50min
TimeoutStopSec=2min
KillMode=control-group
User=root
Group=root
UMask=0077
StateDirectory=camellia-remote-management/maintenance
StateDirectoryMode=0700
ExecStartPre=/usr/bin/test -x /usr/bin/age
ExecStartPre=/usr/bin/test -f /opt/camellia-remote-management/scripts/backup_envelope.py
ExecStartPre=/usr/bin/test ! -L /opt/camellia-remote-management/scripts/backup_envelope.py
ExecStartPre=/usr/bin/test -f /opt/camellia-remote-management/scripts/maintenance_ledger.py
ExecStartPre=/usr/bin/test ! -L /opt/camellia-remote-management/scripts/maintenance_ledger.py
ExecStartPre=/usr/bin/test -x /opt/camellia-remote-management/deploy/run-maintenance-backup.sh
ExecStartPre=/usr/bin/test -x /opt/camellia-remote-management/deploy/run-compose-operation.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=200%
CPUWeight=20
IOWeight=20
MemoryHigh=768M
MemoryMax=1G
TasksMax=256
OOMPolicy=stop
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/camellia-remote-management /var/lib/camellia-remote-management/maintenance
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
SystemCallArchitectures=native
