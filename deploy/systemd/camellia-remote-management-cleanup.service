[Unit]
Description=Remove expired Camellia Remote Management authentication state
After=camellia-remote-management-stack.service

[Service]
Type=oneshot
EnvironmentFile=/etc/camellia-remote-management/management.env
ExecCondition=/opt/camellia-remote-management/management-maintenance-guard.sh
ExecStartPre=/usr/bin/test -x /opt/camellia-remote-management/run-cleanup.sh
ExecStartPre=/usr/bin/test -x /opt/camellia-remote-management/deploy/run-compose-operation.sh
ExecStart=/opt/camellia-remote-management/run-cleanup.sh
TimeoutStartSec=11min
TimeoutStopSec=1min
KillMode=control-group
User=root
Group=root
UMask=0077
Nice=10
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
SystemCallArchitectures=native
