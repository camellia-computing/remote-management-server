# Production must use the digest recorded in the signed GitHub release.
CAMELLIA_REMOTE_MANAGEMENT_IMAGE=ghcr.io/OWNER/REPOSITORY@sha256:REPLACE_WITH_64_HEX_DIGEST

# Generate the first two secrets independently. Keep all three values stable
# across restarts and backups:
# python -c 'import secrets; print(secrets.token_urlsafe(64))'
CAMELLIA_REMOTE_SECRET_KEY=
# Shared Server authentication and deployment-assertion HMAC secret (32-512 non-whitespace characters).
CAMELLIA_REMOTE_DEVICE_VERIFICATION_TOKEN=
# Generate exactly 32 bytes:
# python -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
CAMELLIA_REMOTE_DATA_ENCRYPTION_KEY_ID=primary-v1
CAMELLIA_REMOTE_DATA_ENCRYPTION_KEY=
# Comma-separated old-id:canonical-base64 entries, at most seven.
CAMELLIA_REMOTE_DATA_ENCRYPTION_LEGACY_KEYS=
# Keep this on the key that created legacy secretbox:v1 rows until rotation finishes.
CAMELLIA_REMOTE_DATA_ENCRYPTION_V1_KEY_ID=primary-v1

CAMELLIA_REMOTE_ALLOWED_HOSTS=api.example.com
CAMELLIA_REMOTE_CSRF_TRUSTED_ORIGINS=https://api.example.com
CAMELLIA_REMOTE_API_SERVER=https://api.example.com
# For an HTTPS Web client, include the TLS reverse-proxy port explicitly.
# One WSS origin can route /ws/id and /ws/relay to ports 21118 and 21119.
CAMELLIA_REMOTE_ID_SERVER=wss://remote.example.com:443
CAMELLIA_REMOTE_RELAY_SERVER=
CAMELLIA_REMOTE_DEFAULT_ID_PORT=21116
CAMELLIA_REMOTE_RS_PUB_KEY=

CAMELLIA_REMOTE_API_BIND_PORT=21114
CAMELLIA_REMOTE_TZ=UTC
CAMELLIA_REMOTE_TIME_ZONE=UTC
CAMELLIA_REMOTE_LANGUAGE_CODE=zh-hans
CAMELLIA_REMOTE_LOG_LEVEL=INFO
CAMELLIA_REMOTE_ALLOW_REGISTRATION=false
CAMELLIA_REMOTE_SECURE_TLS=true
CAMELLIA_REMOTE_SECURE_HSTS_SECONDS=31536000
CAMELLIA_REMOTE_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
CAMELLIA_REMOTE_SECURE_HSTS_PRELOAD=false
CAMELLIA_REMOTE_SESSION_COOKIE_AGE_SECONDS=28800
CAMELLIA_REMOTE_LOGIN_ATTEMPT_RETENTION_MINUTES=15
CAMELLIA_REMOTE_OIDC_PENDING_RETENTION_MINUTES=5
CAMELLIA_REMOTE_SHARE_LINK_RETENTION_DAYS=30

# Enable client-address headers only behind a trusted reverse proxy that
# overwrites them. The Gunicorn list controls HTTPS scheme headers separately;
# when the proxy runs on the Docker host, the container usually sees its bridge
# gateway address rather than 127.0.0.1. Retain 127.0.0.1 for the internal
# readiness probe, for example "127.0.0.1,172.17.0.1". Use "*" only while
# CAMELLIA_REMOTE_API_BIND_PORT stays loopback-only and no untrusted container can reach this
# service.
CAMELLIA_REMOTE_TRUST_PROXY_HEADERS=false
CAMELLIA_REMOTE_TRUSTED_PROXY_CIDRS=
CAMELLIA_REMOTE_GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1

# Admission control is mandatory in production. Source limits use trusted
# IPv4 /32 or IPv6 /64 identities; credential/actor/device values are hashed
# before PostgreSQL storage. Recording bytes are charged in addition to the
# request count. Keep the lease longer than the maximum request lifetime.
CAMELLIA_REMOTE_RATE_LIMIT_ENABLED=true
CAMELLIA_REMOTE_RATE_LIMIT_GLOBAL_REQUESTS_PER_MINUTE=12000
CAMELLIA_REMOTE_RATE_LIMIT_SOURCE_REQUESTS_PER_MINUTE=3000
CAMELLIA_REMOTE_RATE_LIMIT_CREDENTIAL_REQUESTS_PER_MINUTE=1200
CAMELLIA_REMOTE_RATE_LIMIT_RECORD_BYTES_PER_MINUTE=268435456
CAMELLIA_REMOTE_RATE_LIMIT_GLOBAL_CONCURRENCY=128
CAMELLIA_REMOTE_RATE_LIMIT_SOURCE_CONCURRENCY=32
CAMELLIA_REMOTE_RATE_LIMIT_CREDENTIAL_CONCURRENCY=8
CAMELLIA_REMOTE_RATE_LIMIT_LOCAL_CAPACITY=50000
CAMELLIA_REMOTE_RATE_LIMIT_CONCURRENCY_LEASE_SECONDS=900

# Process limits.
CAMELLIA_REMOTE_GUNICORN_WORKERS=2
CAMELLIA_REMOTE_GUNICORN_THREADS=2
CAMELLIA_REMOTE_GUNICORN_TIMEOUT_SECONDS=60
CAMELLIA_REMOTE_GUNICORN_GRACEFUL_TIMEOUT_SECONDS=30
CAMELLIA_REMOTE_GUNICORN_KEEP_ALIVE_SECONDS=5
CAMELLIA_REMOTE_GUNICORN_MAX_REQUESTS=1000
CAMELLIA_REMOTE_GUNICORN_MAX_REQUESTS_JITTER=100

# The production Compose stack runs migrations in a dedicated one-shot service.
CAMELLIA_REMOTE_RUN_MIGRATIONS=false

# The Compose stack uses five independent PostgreSQL roles. On the first
# upgrade of an existing volume, BOOTSTRAP_USER/PASSWORD must be that cluster's
# current superuser so the one-shot bootstrap can transfer ownership safely.
# Keep bootstrap as root-only break-glass material; it is never passed to the
# application, migration, backup, or probe client. Every username and every
# password below must be distinct; passwords must contain at least 16 characters.
CAMELLIA_REMOTE_DATABASE_HOST=postgres
CAMELLIA_REMOTE_DATABASE_PORT=5432
CAMELLIA_REMOTE_DATABASE_NAME=camellia_remote
CAMELLIA_REMOTE_DATABASE_BOOTSTRAP_USER=camellia_bootstrap
CAMELLIA_REMOTE_DATABASE_BOOTSTRAP_PASSWORD=
CAMELLIA_REMOTE_DATABASE_MIGRATION_USER=camellia_migration
CAMELLIA_REMOTE_DATABASE_MIGRATION_PASSWORD=
CAMELLIA_REMOTE_DATABASE_RUNTIME_USER=camellia_runtime
CAMELLIA_REMOTE_DATABASE_RUNTIME_PASSWORD=
CAMELLIA_REMOTE_DATABASE_BACKUP_USER=camellia_backup
CAMELLIA_REMOTE_DATABASE_BACKUP_PASSWORD=
CAMELLIA_REMOTE_DATABASE_PROBE_USER=camellia_probe
CAMELLIA_REMOTE_DATABASE_PROBE_PASSWORD=
# "disable" is limited to the private, same-host Compose bridge. Use
# "verify-full" plus a trusted CA for an external or cross-host database.
CAMELLIA_REMOTE_DATABASE_SSLMODE=disable

# Recording limits and persistent destination. The TLS edge must buffer every
# /api/record request within this chunk limit, remove Transfer-Encoding, and
# forward exactly one accurate Content-Length (including 0 for empty bodies).
# Reject chunked/HTTP2 streaming when the edge cannot establish that length.
CAMELLIA_REMOTE_RECORD_UPLOAD_MAX_CHUNK_BYTES=4194304
CAMELLIA_REMOTE_RECORD_UPLOAD_MAX_FILE_BYTES=10737418240
CAMELLIA_REMOTE_RECORD_MAX_ACTIVE_PER_DEVICE=4
CAMELLIA_REMOTE_RECORD_MAX_ACTIVE_PER_OWNER=32
CAMELLIA_REMOTE_RECORD_MAX_ACTIVE_GLOBAL=512
CAMELLIA_REMOTE_RECORD_MAX_FILES_PER_DEVICE=100
CAMELLIA_REMOTE_RECORD_MAX_FILES_PER_OWNER=1000
CAMELLIA_REMOTE_RECORD_MAX_FILES_GLOBAL=100000
CAMELLIA_REMOTE_RECORD_MAX_BYTES_PER_DEVICE=107374182400
CAMELLIA_REMOTE_RECORD_MAX_BYTES_PER_OWNER=1099511627776
CAMELLIA_REMOTE_RECORD_MAX_BYTES_GLOBAL=10995116277760
CAMELLIA_REMOTE_RECORD_ACTIVE_TIMEOUT_MINUTES=1440
CAMELLIA_REMOTE_RECORD_RETENTION_DAYS=30
CAMELLIA_REMOTE_RECORD_ABORTED_RETENTION_DAYS=1
CAMELLIA_REMOTE_RECORD_ORPHAN_QUARANTINE_DAYS=7
CAMELLIA_REMOTE_RECORD_VOLUME_RESERVE_BYTES=2147483648
CAMELLIA_REMOTE_RECORD_VOLUME_RESERVE_INODES=1024
# Production Compose mounts /app/records as a dedicated named volume. Keep
# this true so a lost mount cannot silently fall back to the image directory.
CAMELLIA_REMOTE_RECORD_REQUIRE_MOUNT=true
CAMELLIA_REMOTE_RECORD_CAPABILITY_CACHE_SECONDS=2

# Device inventory pages are projected and sliced by the database. The XLSX
# export uses a write-only workbook, a bounded memory spool, and a streamed
# file response; reject the request instead of exceeding any hard budget.
CAMELLIA_REMOTE_DEVICE_INVENTORY_EXPORT_MAX_ROWS=100000
CAMELLIA_REMOTE_DEVICE_INVENTORY_EXPORT_MAX_BYTES=67108864
CAMELLIA_REMOTE_DEVICE_INVENTORY_EXPORT_DEADLINE_SECONDS=60
CAMELLIA_REMOTE_DEVICE_INVENTORY_EXPORT_SPOOL_MEMORY_BYTES=2097152
CAMELLIA_REMOTE_DEVICE_INVENTORY_EXPORT_CHUNK_SIZE=1000

# Retained audit evidence is independently bounded even when request-rate
# windows reset. Closed connections older than this retention are removed by
# the cleanup timer unless an explicit operator hold is active.
CAMELLIA_REMOTE_AUDIT_MAX_CONNECTIONS_PER_DEVICE=10000
CAMELLIA_REMOTE_AUDIT_MAX_CONNECTIONS_PER_OWNER=100000
CAMELLIA_REMOTE_AUDIT_MAX_CONNECTIONS_GLOBAL=10000000
CAMELLIA_REMOTE_AUDIT_MAX_EVENTS_PER_CONNECTION=100000
CAMELLIA_REMOTE_AUDIT_MAX_EVENTS_PER_DEVICE=1000000
CAMELLIA_REMOTE_AUDIT_MAX_EVENTS_PER_OWNER=10000000
CAMELLIA_REMOTE_AUDIT_MAX_EVENTS_GLOBAL=100000000
# Authenticated hosts refresh this database-time lease every 20 seconds. The
# five-minute cleanup reconciler records telemetry_lost when it expires.
CAMELLIA_REMOTE_AUDIT_CONNECTION_LEASE_SECONDS=90
CAMELLIA_REMOTE_AUDIT_RETENTION_DAYS=90
CAMELLIA_REMOTE_INGESTION_CLEANUP_BATCH_SIZE=100

CAMELLIA_REMOTE_DATABASE_CONN_MAX_AGE=60
CAMELLIA_REMOTE_DATABASE_CONNECT_TIMEOUT=10

# The hourly backup timer retains seven days by default. The cleanup timer
# independently removes expired authentication and bounded ingestion state every five minutes.
CAMELLIA_REMOTE_BACKUP_RETENTION_HOURS=168

# Paired PostgreSQL and authoritative recording-inventory/ciphertext backups
# are age-encrypted and bound to one frozen epoch. Generate a recipient with
# the reviewed, pinned age tool and keep
# the matching identity outside this runtime environment (never in this file,
# the management container, or a backup artifact). Rotate by assigning a new
# key ID/recipient, retaining the old identity until every retained backup has
# been restored or expired.
CAMELLIA_REMOTE_BACKUP_AGE_RECIPIENT=
CAMELLIA_REMOTE_BACKUP_AGE_KEY_ID=backup-v1
CAMELLIA_REMOTE_BACKUP_DEPLOYMENT_ID=
# Restore-only guard: the PostgreSQL major version expected by restore drills.
CAMELLIA_REMOTE_BACKUP_POSTGRES_MAJOR=18

# Configure every OIDC value together or leave every value empty.
CAMELLIA_REMOTE_OIDC_NAME=
CAMELLIA_REMOTE_OIDC_ISSUER=
CAMELLIA_REMOTE_OIDC_CLIENT_ID=
CAMELLIA_REMOTE_OIDC_CLIENT_SECRET=
CAMELLIA_REMOTE_OIDC_REDIRECT_URI=
CAMELLIA_REMOTE_OIDC_ALLOWED_HOSTS=
CAMELLIA_REMOTE_OIDC_SCOPE=openid email profile
CAMELLIA_REMOTE_OIDC_HTTP_TIMEOUT_SECONDS=10
# Unknown OIDC identities are denied by default. Enabling auto-provision also
# requires at least one exact verified-email domain or claim allowlist. Every
# configured claim is required; a scalar or array claim must contain one of its
# configured strings, for example {"tid":["tenant-id"],"groups":["remote-users"]}.
CAMELLIA_REMOTE_OIDC_AUTO_PROVISION=false
CAMELLIA_REMOTE_OIDC_AUTO_PROVISION_EMAIL_DOMAINS=
CAMELLIA_REMOTE_OIDC_AUTO_PROVISION_REQUIRED_CLAIMS=
